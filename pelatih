            const nomOk = listOk.reduce((sum, i) => sum + Math.max(0, parseFloat(i.nominal || 0)), 0);

            document.getElementById("dash-kas-ok").innerText = formatRupiah(nomOk);
            document.getElementById("dash-kas-pending").innerText = `${listPending.length} Menunggu konfirmasi`;
            document.getElementById("dash-total-kas-count").innerText = dataKasAnggotaRayon.length;
