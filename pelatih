        // Helper Pagination Otomatis 10 Nomor
        function paginateData(menu, list) {
            const total = list.length;
            const totalPages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE));
            let page = paginationState[menu] || 1;
            if (page > totalPages) page = totalPages;
            if (page < 1) page = 1;
            paginationState[menu] = page;

            const startIdx = (page - 1) * ITEMS_PER_PAGE;
            const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, total);
            const paged = list.slice(startIdx, endIdx);

            renderPaginationControls(menu, page, totalPages, startIdx, endIdx, total);
            return { paged, startIdx };
        }

        function renderPaginationControls(menu, page, totalPages, startIdx, endIdx, total) {
            const container = document.getElementById("pagination-" + menu);
            if (!container) return;

            if (total === 0) {
                container.classList.add("hidden");
                container.innerHTML = "";
                return;
            }

            const pages = [];
            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (page > 3) pages.push("...");
                const start = Math.max(2, page - 1);
                const end = Math.min(totalPages - 1, page + 1);
                for (let i = start; i <= end; i++) pages.push(i);
                if (page < totalPages - 2) pages.push("...");
                pages.push(totalPages);
            }

            const pageButtons = pages.map(p => {
                if (p === "...") {
                    return `<span class="px-2 py-1 text-slate-400 select-none">...</span>`;
                }
                const active = p === page;
                return `
                    <button type="button" onclick="gantiHalaman('${menu}', ${p})"
                        class="min-w-[30px] h-[30px] px-2 rounded-lg text-xs font-bold transition-colors cursor-pointer ${
                            active
                                ? "bg-emerald-600 text-white shadow-sm"
                                : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-100"
                        }">
                        ${p}
                    </button>
                `;
            }).join("");

            container.className = "px-4 py-3 border-t border-slate-200 bg-slate-50/60 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs";
            container.innerHTML = `
                <p class="text-[11px] text-slate-500 font-medium">
                    Menampilkan <b class="text-slate-700">${startIdx + 1}–${endIdx}</b> dari <b class="text-slate-700">${total}</b> data
                    <span class="text-slate-400">• Halaman ${page} / ${totalPages}</span>
                </p>
                <div class="flex items-center gap-1 flex-wrap justify-center">
                    <button type="button" onclick="gantiHalaman('${menu}', ${page - 1})" ${page <= 1 ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                    </button>
                    ${pageButtons}
                    <button type="button" onclick="gantiHalaman('${menu}', ${page + 1})" ${page >= totalPages ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                </div>
            `;
        }

        function gantiHalaman(menu, page) {
            paginationState[menu] = page;
            const renderMap = {
                peserta: renderPeserta,
                absensi: renderAbsensi,
                kasAnggota: renderKasAnggota
            };
            if (renderMap[menu]) renderMap[menu]();
        }

        // Helpers
        function esc(str) {
            if (str === null || str === undefined) return "";
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function safeJsonAttr(val) {
            return JSON.stringify(val || "")
                .replace(/'/g, "\\u0027")
                .replace(/</g, "\\u003c")
                .replace(/>/g, "\\u003e");
        }

        function todayISO() {
            const d = new Date();
            const offset = d.getTimezoneOffset() * 60000;
            return new Date(d.getTime() - offset).toISOString().split("T")[0];
        }

        function formatTanggal(tglStr) {
            if (!tglStr || tglStr === "-") return "-";
            const date = new Date(tglStr);
            if (isNaN(date.getTime())) return esc(tglStr);
            return date.toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
        }

        function formatRupiah(num) {
            return "Rp " + parseFloat(num || 0).toLocaleString("id-ID");
        }

        function klasifikasiGender(jk) {
            const val = String(jk || "").trim().toLowerCase();
            if (val === "l" || val.includes("putra") || val.includes("laki") || val.includes("pria")) return "putra";
            if (val === "p" || val.includes("putri") || val.includes("perempuan") || val.includes("wanita")) return "putri";
            return "lainnya";
        }

        function getInisial(nama) {
            const parts = String(nama || "P").trim().split(/\s+/);
            if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
            return (parts[0] || "P").slice(0, 2).toUpperCase();
        }

        let toastTimer = null;
        function tampilkanNotif(pesan, isError = false) {
            const toast = document.getElementById("toast-notif");
            const icon = document.getElementById("toast-icon");
            const text = document.getElementById("toast-text");
