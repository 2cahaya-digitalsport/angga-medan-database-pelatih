                        <p class="text-[11px] text-slate-500"><i class="fa-solid fa-user-tie text-amber-500 mr-1.5"></i>Pelatih: ${esc(r.pelatih_tetap || "-")}</p>
                    </div>
                `).join("");

            // Rekap Kualifikasi Usia
            const rekapKualEl = document.getElementById("dash-rekap-kualifikasi");
            const entriKual = Object.entries(mapKual).sort((a, b) => b[1] - a[1]);
            rekapKualEl.innerHTML = entriKual.length === 0
                ? `<p class="text-xs text-slate-400 text-center py-6">Belum ada data peserta.</p>`
                : entriKual.map(([nama, jml]) => {
                    const persen = dataPesertaRayon.length > 0 ? Math.round((jml / dataPesertaRayon.length) * 100) : 0;
                    return `
                        <div class="space-y-1">
                            <div class="flex justify-between text-xs">
                                <span class="font-bold text-slate-700">${esc(nama)}</span>
                                <span class="font-bold text-slate-600">${jml} (${persen}%)</span>
                            </div>
                            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width:${persen}%"></div>
                            </div>
                        </div>
                    `;
                }).join("");
        }

        // ==================== 2. RENDER DATA PESERTA RAYON ====================
        function getFilteredPeserta() {
            const filterKual = document.getElementById("filter-peserta-kualifikasi").value.toLowerCase();
            const filterJk = document.getElementById("filter-peserta-jk").value;
            const kueri = (document.getElementById("cari-peserta").value || "").toLowerCase();

            return dataPesertaRayon.filter(item => {
                const matchKual = !filterKual || (item.kualifikasi_usia || "").trim().toLowerCase() === filterKual;
                const matchJk = !filterJk || klasifikasiGender(item.jenis_kelamin) === filterJk;
                const teks = `${item.nama_lengkap || ""} ${item.nia || ""} ${item.whatsapp || ""} ${item.alamat || ""} ${item.kualifikasi_usia || ""}`.toLowerCase();
                return matchKual && matchJk && teks.includes(kueri);
            });
        }

