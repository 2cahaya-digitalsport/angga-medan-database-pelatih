        // Cek apakah akun terdaftar sebagai Pelatih
        function isAkunPelatih(anggota, rayonList) {
            if (!anggota) return false;
            const kual = String(anggota.kualifikasi_usia || "").trim().toLowerCase();
            if (kual.includes("pelatih")) return true;

            const namaLower = String(anggota.nama_lengkap || "").trim().toLowerCase();
            if (!namaLower) return false;

            return (rayonList || []).some(r => {
                const daftarPelatih = String(r.pelatih_tetap || "")
                    .split(/[,;/\n&]|\s+dan\s+/i)
                    .map(s => s.trim().toLowerCase())
                    .filter(Boolean);
                return daftarPelatih.includes(namaLower);
            });
        }

        // Proses Login Pelatih (User & Password dari Data Peserta pada Halaman Admin)
        async function prosesLoginPelatih(event) {
            event.preventDefault();
            const userInput = document.getElementById("login-user").value.trim();
            const passInput = document.getElementById("login-pass").value;
            const errorBox = document.getElementById("login-error");
            const errorText = document.getElementById("login-error-text");
            const btnLogin = document.getElementById("btn-login");

            errorBox.classList.add("hidden");
            btnLogin.disabled = true;
            btnLogin.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i><span>MEMERIKSA AKUN...</span>`;

            try {
                const [snapAnggota, snapRayon] = await Promise.all([
                    database.ref("administrasi_digital/anggota").once("value"),
                    database.ref("administrasi_digital/rayon").once("value")
                ]);

                const valAnggota = snapAnggota.val() || {};
                const listAnggota = Object.entries(valAnggota).map(([key, item]) => ({ ...item, id: item.id || key }));

                const valRayon = snapRayon.val() || {};
                const listRayon = Object.entries(valRayon).map(([key, item]) => ({ ...item, id: item.id || key }));

                const ditemukan = listAnggota.find(item => {
                    const u = String(item.username || item.user || "").trim().toLowerCase();
                    const p = String(item.password || item.sandi || "");
                    return u === userInput.toLowerCase() && p === passInput;
                });

                if (!ditemukan) {
                    errorText.innerText = "Username atau kata sandi pelatih tidak ditemukan.";
                    errorBox.classList.remove("hidden");
                    return;
                }

                if (ditemukan.status === "Menunggu") {
                    errorText.innerText = "Akun Anda masih menunggu persetujuan Admin.";
                    errorBox.classList.remove("hidden");
                    return;
                }

                if (ditemukan.status === "Ditolak") {
                    errorText.innerText = "Akun Anda ditolak oleh Admin.";
                    errorBox.classList.remove("hidden");
                    return;
                }

                if (!isAkunPelatih(ditemukan, listRayon)) {
                    errorText.innerText = "Akses ditolak. Akun ini tidak berstatus Pelatih.";
                    errorBox.classList.remove("hidden");
                    return;
                }

                pelatihAktif = {
                    id: ditemukan.id,
                    nama_lengkap: ditemukan.nama_lengkap || "Pelatih",
                    nia: ditemukan.nia || "",
                    ranting_rayon: (ditemukan.ranting_rayon || "").trim(),
                    username: ditemukan.username || ditemukan.user || userInput,
                    foto: ditemukan.foto || "",
                    whatsapp: ditemukan.whatsapp || "",
                    kualifikasi_usia: ditemukan.kualifikasi_usia || "Pelatih"
                };

                sessionStorage.setItem(SESSION_KEY, JSON.stringify(pelatihAktif));
                bukaHalamanPelatih();
            } catch (e) {
                errorText.innerText = "Gagal menghubungkan ke database: " + e.message;
                errorBox.classList.remove("hidden");
            } finally {
                btnLogin.disabled = false;
                btnLogin.innerHTML = `<i class="fa-solid fa-right-to-bracket"></i><span>MASUK HALAMAN PELATIH</span>`;
            }
        }

        function perbaruiTampilanProfilPelatih() {
            if (!pelatihAktif) return;
            const nama = pelatihAktif.nama_lengkap || "Pelatih";
            const rayon = pelatihAktif.ranting_rayon || "Belum Diatur";

            document.getElementById("sidebar-nama-pelatih").innerText = nama;
            document.getElementById("sidebar-rayon-pelatih").innerHTML = `<i class="fa-solid fa-location-dot text-[9px] mr-1"></i>${esc(rayon)}`;
            document.getElementById("topbar-rayon").innerText = `Gelanggang PD • ${rayon}`;
            document.getElementById("dash-welcome-title").innerText = `Selamat Datang, ${nama}`;
            document.getElementById("dash-welcome-sub").innerText = `Data khusus peserta, absensi, dan riwayat kas wilayah ${rayon}`;
            document.getElementById("dash-profil-rayon").innerText = rayon;
            document.getElementById("dash-profil-pelatih").innerText = `Pelatih: ${nama}${pelatihAktif.nia ? " (" + pelatihAktif.nia + ")" : ""}`;
            document.getElementById("dash-rayon-badge").innerText = rayon;
            document.getElementById("sub-peserta-rayon").innerText = `Menampilkan seluruh anggota aktif di ${rayon}`;
            document.getElementById("absen-rayon").value = rayon;

            const avatarEl = document.getElementById("sidebar-avatar");
            if (pelatihAktif.foto && !pelatihAktif.foto.includes("via.placeholder.com")) {
                avatarEl.innerHTML = `<img src="${esc(pelatihAktif.foto)}" alt="Foto" class="w-full h-full object-cover">`;
            } else {
                avatarEl.innerText = getInisial(nama);
            }
        }

        function bukaHalamanPelatih() {
            document.getElementById("page-login").classList.add("hidden");
            document.getElementById("page-pelatih").classList.remove("hidden");
            sidebarTerbuka = window.innerWidth >= 1024;
            terapkanStateSidebar();

            perbaruiTampilanProfilPelatih();
            document.getElementById("absen-tanggal").value = todayISO();
            document.getElementById("ka-tanggal").value = todayISO();

            pilihTab("dashboard");
            aktifkanRealtimeData();
        }

        function prosesLogout() {
            sessionStorage.removeItem(SESSION_KEY);
            pelatihAktif = null;
            Object.keys(paginationState).forEach(k => paginationState[k] = 1);
            if (listenersAktif) {
                database.ref("administrasi_digital/anggota").off();
                database.ref("administrasi_digital/absensi").off();
                database.ref("administrasi_digital/rayon").off();
                database.ref("administrasi_digital/kas_anggota").off();
                listenersAktif = false;
            }
            document.getElementById("form-login-pelatih").reset();
            document.getElementById("login-error").classList.add("hidden");
            document.getElementById("page-pelatih").classList.add("hidden");
            document.getElementById("page-login").classList.remove("hidden");
        }

