                    <td style="font-weight:700; color:#0f172a;">${esc(item.nama_lengkap || "-")}</td>
                    <td>${esc(item.ranting_rayon || "-")}</td>
                    <td style="text-align:center; font-weight:700;">${esc(item.status || "-")}</td>
                    <td>${esc(item.keterangan || "-")}</td>
                </tr>
            `).join("");

            document.getElementById("print-area").innerHTML = `
                <div class="print-header">
                    <div>
                        <div style="font-size:13pt; font-weight:900; color:#065f46; text-transform:uppercase; letter-spacing:0.03em;">
                            GELANGGANG PD
                        </div>
                        <div style="font-size:10.5pt; font-weight:700; color:#0f172a; margin-top:2px;">
                            LAPORAN ABSENSI ANGGOTA — ${esc(rayon.toUpperCase())}
                        </div>
                        <div style="font-size:8pt; color:#475569; margin-top:2px;">
                            Hadir: <b>${jmlHadir}</b> • Izin: <b>${jmlIzin}</b> • Sakit: <b>${jmlSakit}</b> • Alpha: <b>${jmlAlpha}</b>
                        </div>
                    </div>
                    <div style="text-align:right; font-size:8pt; color:#475569;">
                        <div>Pelatih: <b>${esc(namaPelatih)}</b></div>
                        <div>Tanggal Cetak: <b>${esc(tanggalCetak)}</b> • Total: <b>${list.length} Data</b></div>
                    </div>
                </div>
                <table class="print-table">
                    <thead>
                        <tr>
                            <th style="width:6%; text-align:center;">No</th>
                            <th style="width:14%;">Tanggal</th>
                            <th style="width:24%;">Nama Peserta</th>
                            <th style="width:18%;">Ranting / Rayon</th>
                            <th style="width:12%; text-align:center;">Status</th>
                            <th style="width:26%;">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rowsHtml}
                    </tbody>
                </table>
            `;

            setTimeout(() => window.print(), 150);
        }

        function cetakPDFKasAnggota() {
            const list = getFilteredKasAnggota();
            if (list.length === 0) {
                tampilkanNotif("Tidak ada data riwayat kas anggota untuk dicetak.", true);
                return;
            }

            const tanggalCetak = new Date().toLocaleDateString("id-ID", {
                day: "2-digit", month: "long", year: "numeric"
            });
            const rayon = pelatihAktif?.ranting_rayon || "-";
            const namaPelatih = pelatihAktif?.nama_lengkap || "-";

            const totalOk = list
                .filter(i => i.status === "Dikonfirmasi")
                .reduce((s, i) => s + Math.max(0, parseFloat(i.nominal || 0)), 0);
            const totalPending = list
                .filter(i => (i.status || "Menunggu") === "Menunggu")
                .reduce((s, i) => s + Math.max(0, parseFloat(i.nominal || 0)), 0);

            const rowsHtml = list.map((item, idx) => `
                <tr>
                    <td style="text-align:center;">${idx + 1}</td>
                    <td>${formatTanggal(item.tanggal)}</td>
                    <td style="font-weight:700; color:#0f172a;">${esc(item.nama_anggota || "-")}</td>
                    <td>${esc(item.ranting_rayon || rayon)}</td>
                    <td style="text-align:right; font-weight:700; color:#0369a1;">${formatRupiah(item.nominal)}</td>
                    <td>${esc(item.keterangan || "-")}</td>
                    <td style="text-align:center; font-weight:700;">${esc(item.status || "Menunggu")}</td>
                </tr>
            `).join("");

            document.getElementById("print-area").innerHTML = `
                <div class="print-header">
                    <div>
                        <div style="font-size:13pt; font-weight:900; color:#065f46; text-transform:uppercase; letter-spacing:0.03em;">
                            GELANGGANG PD
                        </div>
                        <div style="font-size:10.5pt; font-weight:700; color:#0f172a; margin-top:2px;">
                            LAPORAN RIWAYAT KAS ANGGOTA — ${esc(rayon.toUpperCase())}
                        </div>
                        <div style="font-size:8pt; color:#475569; margin-top:2px;">
                            Terkonfirmasi: <b>${formatRupiah(totalOk)}</b> • Menunggu: <b>${formatRupiah(totalPending)}</b>
                        </div>
                    </div>
                    <div style="text-align:right; font-size:8pt; color:#475569;">
                        <div>Pelatih: <b>${esc(namaPelatih)}</b></div>
                        <div>Tanggal Cetak: <b>${esc(tanggalCetak)}</b> • Total: <b>${list.length} Transaksi</b></div>
                    </div>
                </div>
                <table class="print-table">
                    <thead>
                        <tr>
                            <th style="width:5%; text-align:center;">No</th>
                            <th style="width:12%;">Tanggal</th>
                            <th style="width:20%;">Nama Anggota</th>
                            <th style="width:15%;">Ranting / Rayon</th>
                            <th style="width:13%; text-align:right;">Nominal</th>
                            <th style="width:23%;">Keterangan</th>
                            <th style="width:12%; text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rowsHtml}
                    </tbody>
                </table>
            `;

            setTimeout(() => window.print(), 150);
        }

        // Modal Preview Foto & Modal Detail
        function bukaPreviewFoto(src, caption) {
            document.getElementById("preview-img").src = src;
            document.getElementById("preview-caption").innerText = caption || "";
            document.getElementById("modal-preview").classList.remove("hidden");
        }

        function tutupPreviewFoto() {
            document.getElementById("modal-preview").classList.add("hidden");
        }

        function tutupModalDetail() {
            document.getElementById("modal-detail").classList.add("hidden");
        }

        // Auto Restore Session Pelatih saat refresh
        window.addEventListener("DOMContentLoaded", () => {
            const saved = sessionStorage.getItem(SESSION_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    if (parsed && parsed.id) {
                        pelatihAktif = parsed;
                        bukaHalamanPelatih();
                    }
                } catch (e) {
                    sessionStorage.removeItem(SESSION_KEY);
                }
            }
        });
    </script>
</body>
</html>
