        // Sinkronkan Seluruh Data Khusus Rayon / Ranting Pelatih
        function sinkronDataRayonPelatih() {
            if (!pelatihAktif) return;

            // Update info profil pelatih jika ada pembaruan dari Admin
            const akunTerbaru = rawAnggotaList.find(a => String(a.id) === String(pelatihAktif.id));
            if (akunTerbaru) {
                pelatihAktif.nama_lengkap = akunTerbaru.nama_lengkap || pelatihAktif.nama_lengkap;
                pelatihAktif.ranting_rayon = (akunTerbaru.ranting_rayon || pelatihAktif.ranting_rayon || "").trim();
                pelatihAktif.foto = akunTerbaru.foto || pelatihAktif.foto;
                pelatihAktif.nia = akunTerbaru.nia || pelatihAktif.nia;
                sessionStorage.setItem(SESSION_KEY, JSON.stringify(pelatihAktif));
                perbaruiTampilanProfilPelatih();
            }

            const rayonKey = (pelatihAktif.ranting_rayon || "").trim().toLowerCase();

            // 1. Data Peserta Rayon / Ranting Pelatih
            dataPesertaRayon = rawAnggotaList
                .filter(item => {
                    const st = item.status || "Dikonfirmasi";
                    const aktif = st !== "Menunggu" && st !== "Ditolak";
                    const samaRayon = rayonKey && (item.ranting_rayon || "").trim().toLowerCase() === rayonKey;
                    return aktif && samaRayon;
                })
                .sort((a, b) => (a.nama_lengkap || "").localeCompare(b.nama_lengkap || ""));

            const setIdsAnggotaRayon = new Set(dataPesertaRayon.map(a => String(a.id)));
            const setNamaAnggotaRayon = new Set(dataPesertaRayon.map(a => (a.nama_lengkap || "").trim().toLowerCase()).filter(Boolean));

            // 2. Data Absensi Anggotanya Saja
            dataAbsensiRayon = rawAbsensiList
                .filter(item => {
                    const samaRayon = rayonKey && (item.ranting_rayon || "").trim().toLowerCase() === rayonKey;
                    const samaId = item.peserta_id && setIdsAnggotaRayon.has(String(item.peserta_id));
                    return samaRayon || samaId;
                })
                .sort((a, b) => new Date(b.tanggal || 0) - new Date(a.tanggal || 0));

            // 3. Data Riwayat Kas Anggotanya Saja
            dataKasAnggotaRayon = rawKasAnggotaList
                .filter(item => {
                    const samaRayon = rayonKey && (item.ranting_rayon || "").trim().toLowerCase() === rayonKey;
                    const samaId = item.anggota_id && setIdsAnggotaRayon.has(String(item.anggota_id));
                    const samaNama = !item.ranting_rayon && !item.anggota_id && item.nama_anggota && setNamaAnggotaRayon.has(item.nama_anggota.trim().toLowerCase());
                    return samaRayon || samaId || samaNama;
                })
                .sort((a, b) => {
                    const diff = new Date(b.tanggal || 0) - new Date(a.tanggal || 0);
                    if (diff !== 0) return diff;
                    return String(b.id || "").localeCompare(String(a.id || ""));
                });

            // 4. Jadwal Rayon Pelatih
            dataRayonPelatih = rawRayonList
                .filter(r => rayonKey && (r.nama_rayon_ranting || "").trim().toLowerCase() === rayonKey)
                .sort((a, b) => (a.nama_rayon_ranting || "").localeCompare(b.nama_rayon_ranting || ""));

            // Badges Sidebar
            document.getElementById("sidebar-peserta-badge").innerText = dataPesertaRayon.length;

            const pendingAbsen = dataAbsensiRayon.filter(i => i.status === "Menunggu").length;
            const badgeAbsen = document.getElementById("sidebar-absensi-badge");
            badgeAbsen.innerText = pendingAbsen;
            if (pendingAbsen > 0) badgeAbsen.classList.remove("hidden");
            else badgeAbsen.classList.add("hidden");

            const pendingKas = dataKasAnggotaRayon.filter(i => (i.status || "Menunggu") === "Menunggu").length;
            const badgeKas = document.getElementById("sidebar-kas-badge");
            badgeKas.innerText = pendingKas;
            if (pendingKas > 0) badgeKas.classList.remove("hidden");
            else badgeKas.classList.add("hidden");

            sinkronOpsiDropdownAnggota();
            renderDashboard();
            renderPeserta();
            renderAbsensi();
            renderKasAnggota();
        }

        // Firebase Realtime Listeners
        function aktifkanRealtimeData() {
            if (listenersAktif) return;
            listenersAktif = true;

            database.ref("administrasi_digital/anggota").on("value", snap => {
                const val = snap.val();
                rawAnggotaList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                sinkronDataRayonPelatih();
            });

            database.ref("administrasi_digital/absensi").on("value", snap => {
                const val = snap.val();
                rawAbsensiList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                sinkronDataRayonPelatih();
            });

            database.ref("administrasi_digital/rayon").on("value", snap => {
                const val = snap.val();
                rawRayonList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                sinkronDataRayonPelatih();
            });

            database.ref("administrasi_digital/kas_anggota").on("value", snap => {
                const val = snap.val();
                rawKasAnggotaList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                sinkronDataRayonPelatih();
            });
        }

        // Sinkron Dropdown Anggota Rayon untuk Form Absensi & Form Kas Anggota
        function sinkronOpsiDropdownAnggota() {
            const opsiHtml = dataPesertaRayon.length === 0
                ? `<option value="">-- Tidak ada anggota di rayon ini --</option>`
                : `<option value="">-- Pilih Anggota (${esc(pelatihAktif?.ranting_rayon || "-")}) --</option>` +
                  dataPesertaRayon.map(a => {
                      const niaLabel = a.nia ? ` [${a.nia}]` : "";
                      const kualLabel = a.kualifikasi_usia ? ` • ${a.kualifikasi_usia}` : "";
                      return `<option value="${esc(a.id)}" data-nama="${esc(a.nama_lengkap || "")}" data-rayon="${esc(a.ranting_rayon || "")}">${esc(a.nama_lengkap || "-")}${esc(niaLabel)}${esc(kualLabel)}</option>`;
                  }).join("");

            const absenSelect = document.getElementById("absen-peserta");
            if (absenSelect) {
                const cur = absenSelect.value;
                absenSelect.innerHTML = opsiHtml;
                if (cur && Array.from(absenSelect.options).some(o => o.value === cur)) absenSelect.value = cur;
            }

            const kaSelect = document.getElementById("ka-anggota");
            const kaBadge = document.getElementById("ka-jml-anggota-badge");
            if (kaBadge) kaBadge.innerText = `(${dataPesertaRayon.length} terdaftar)`;
            if (kaSelect) {
                const cur = kaSelect.value;
                kaSelect.innerHTML = opsiHtml;
                if (cur && Array.from(kaSelect.options).some(o => o.value === cur)) kaSelect.value = cur;
            }
        }

        // ==================== 1. RENDER DASHBOARD PELATIH ====================
        function renderDashboard() {
            let putra = 0, putri = 0;
            const mapKual = {};

            dataPesertaRayon.forEach(a => {
                const g = klasifikasiGender(a.jenis_kelamin);
                if (g === "putra") putra++;
                else if (g === "putri") putri++;

                const kName = (a.kualifikasi_usia || "").trim() || "Belum Diisi";
                mapKual[kName] = (mapKual[kName] || 0) + 1;
            });

            document.getElementById("dash-total-peserta").innerText = dataPesertaRayon.length;
            document.getElementById("dash-putra-putri").innerText = `${putra} Putra • ${putri} Putri`;

            const hariIni = todayISO();
            const absenHariIni = dataAbsensiRayon.filter(a => a.tanggal === hariIni).length;
            const totalHadir = dataAbsensiRayon.filter(a => a.status === "Hadir").length;
            document.getElementById("dash-absen-hari-ini").innerText = absenHariIni;
            document.getElementById("dash-absen-hadir-total").innerText = `${totalHadir} Total Hadir tercatat`;

