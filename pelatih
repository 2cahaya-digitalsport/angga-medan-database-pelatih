        async function simpanKasAnggota(event) {
            event.preventDefault();
            const idLama = document.getElementById("ka-id").value;
            const id = idLama || String(Date.now());
            const existing = dataKasAnggotaRayon.find(k => String(k.id) === String(idLama));

            const selectAnggota = document.getElementById("ka-anggota");
            const anggotaId = selectAnggota.value;
            if (!anggotaId) {
                tampilkanNotif("Silakan pilih anggota rayon terlebih dahulu.", true);
                return;
            }

            const anggotaObj = dataPesertaRayon.find(a => String(a.id) === String(anggotaId));
            const optSelected = selectAnggota.options[selectAnggota.selectedIndex];
            const namaAnggota = anggotaObj ? anggotaObj.nama_lengkap : (optSelected?.dataset?.nama || "");
            const rayonAnggota = anggotaObj ? (anggotaObj.ranting_rayon || "") : (pelatihAktif?.ranting_rayon || "");

            const nominal = Math.max(0, Number(document.getElementById("ka-nominal").value || 0));
            if (nominal <= 0) {
                tampilkanNotif("Nominal harus lebih dari 0.", true);
                return;
            }

            const tanggal = document.getElementById("ka-tanggal").value;
            const keterangan = document.getElementById("ka-ket").value.trim();
            const statusSaatIni = existing ? (existing.status || "Menunggu") : "Menunggu";

            const payload = {
                id: id,
                tanggal: tanggal,
                anggota_id: anggotaId,
                nama_anggota: namaAnggota,
                ranting_rayon: rayonAnggota,
                nominal: nominal,
                keterangan: keterangan,
                status: statusSaatIni
            };

            try {
                await database.ref("administrasi_digital/kas_anggota/" + id).set(payload);
                if (statusSaatIni === "Dikonfirmasi") {
                    await sinkronKasAnggotaKeKeuangan(payload);
                }
                tampilkanNotif(idLama ? "Pembayaran kas anggota diperbarui." : "Pembayaran kas anggota ditambahkan (Menunggu konfirmasi).");
                resetFormKasAnggota(true);
            } catch (e) {
                tampilkanNotif("Gagal menyimpan kas anggota: " + e.message, true);
            }
        }

        async function sinkronKasAnggotaKeKeuangan(item) {
            const keuanganId = "ka_" + item.id;
            const payloadKas = {
                id: keuanganId,
                tanggal: item.tanggal || todayISO(),
                tipe: "pemasukan",
                nominal: Math.max(0, Number(item.nominal || 0)),
                keterangan: `Kas Anggota: ${item.nama_anggota}${item.keterangan ? " (" + item.keterangan + ")" : ""}`,
                foto: "",
                sumber_kas_anggota_id: item.id
            };
            await database.ref("administrasi_digital/keuangan/" + keuanganId).set(payloadKas);
        }

