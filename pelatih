            const jadwalEl = document.getElementById("dash-jadwal-rayon");
            jadwalEl.innerHTML = dataRayonPelatih.length === 0
                ? `<p class="text-xs text-slate-400 text-center py-6">Jadwal latihan untuk ${esc(pelatihAktif?.ranting_rayon || "rayon ini")} belum diatur oleh Admin.</p>`
                : dataRayonPelatih.map(r => `
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-xs font-bold text-slate-800">${esc(r.nama_rayon_ranting || "-")}</p>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700">${esc(r.kategori_rr || "Rayon")}</span>
                        </div>
                        <p class="text-[11px] text-slate-600"><i class="fa-solid fa-clock text-purple-500 mr-1.5"></i>${esc(r.jadwal_hari || "-")} • ${esc(r.jam_latihan || "-")}</p>
