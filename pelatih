        const SESSION_KEY = "pelatih_portal_login";

        // Pagination Otomatis 10 Baris/Nomor Per Halaman
        const ITEMS_PER_PAGE = 10;
        const paginationState = {
            peserta: 1,
            absensi: 1,
            kasAnggota: 1
