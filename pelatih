<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Halaman Pelatih - Gelanggang PD</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <style>
        html, body {
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }
        body {
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        @media (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }
        .sidebar-link-active {
            background-color: #059669;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        /* ==================== CETAK PDF RAPI TANPA TERPOTONG ==================== */
        #print-area {
            display: none;
        }
        @page {
            size: A4 landscape;
            margin: 10mm;
        }
        @media print {
            html, body {
                background: #ffffff !important;
                color: #0f172a !important;
                margin: 0 !important;
                padding: 0 !important;
                height: auto !important;
                min-height: 0 !important;
                overflow: visible !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            body > *:not(#print-area) {
                display: none !important;
            }
            #print-area {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .print-header {
                border-bottom: 2px solid #047857;
                padding-bottom: 8px;
                margin-bottom: 10px;
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 12px;
            }
            .print-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 8.5pt;
            }
            .print-table thead {
                display: table-header-group;
            }
            .print-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            .print-table th,
            .print-table td {
                border: 1px solid #94a3b8;
                padding: 5px 6px;
                vertical-align: top;
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }
            .print-table th {
                background-color: #047857 !important;
                color: #ffffff !important;
                font-weight: 700;
                text-align: left;
                text-transform: uppercase;
                font-size: 7.5pt;
                letter-spacing: 0.02em;
            }
            .print-table tbody tr:nth-child(even) {
                background-color: #f8fafc !important;
            }
            .print-foto {
                width: 30px;
                height: 36px;
                object-fit: cover;
                border-radius: 4px;
                border: 1px solid #cbd5e1;
                display: block;
                margin: 0 auto;
            }
            .print-initial {
                width: 30px;
                height: 36px;
                border-radius: 4px;
                background-color: #e2e8f0 !important;
                color: #475569 !important;
                font-weight: 700;
                font-size: 9pt;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
                border: 1px solid #cbd5e1;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- ==================== HALAMAN LOGIN PELATIH (TANPA SCROLL & TANPA TERPOTONG) ==================== -->
    <section id="page-login" class="h-[100dvh] w-full overflow-hidden flex items-center justify-center p-3 sm:p-6 bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900">
        <div class="w-full max-w-md max-h-full bg-white rounded-3xl shadow-2xl overflow-hidden border border-emerald-700/20 flex flex-col justify-center">
            <!-- Header Card Login -->
            <div class="bg-emerald-700 px-5 py-4 sm:py-6 text-center text-white relative shrink-0">
                <div class="w-14 h-14 sm:w-18 sm:h-18 bg-white/15 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-2 sm:mb-3 border-4 border-white/40 shadow-lg">
                    <i class="fa-solid fa-user-tie text-2xl sm:text-3xl text-white"></i>
                </div>
                <h1 class="text-lg sm:text-2xl font-black tracking-tight uppercase leading-tight">
                    Halaman Pelatih
                </h1>
                <p class="text-[11px] sm:text-xs text-emerald-100 font-semibold uppercase tracking-widest mt-0.5">
                    Gelanggang PD
                </p>
            </div>

            <!-- Form Login Pelatih -->
            <form id="form-login-pelatih" onsubmit="prosesLoginPelatih(event)" class="p-4 sm:p-7 space-y-3 sm:space-y-4">
                <div id="login-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium px-3.5 py-2.5 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm shrink-0"></i>
                    <span id="login-error-text">Username atau password salah.</span>
                </div>

                <div>
                    <label for="login-user" class="block text-[11px] sm:text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
                        Username Pelatih
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>
                        <input type="text" id="login-user" required autocomplete="username"
                            placeholder="Masukkan user akun pelatih"
                            class="w-full pl-10 pr-4 py-2.5 sm:py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                    </div>
                </div>

                <div>
                    <label for="login-pass" class="block text-[11px] sm:text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
                        Kata Sandi
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input type="password" id="login-pass" required autocomplete="current-password"
                            placeholder="Masukkan kata sandi"
                            class="w-full pl-10 pr-11 py-2.5 sm:py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                        <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Tampilkan sandi">
                            <i id="icon-eye" class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btn-login"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-xs sm:text-sm py-3 sm:py-3.5 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>MASUK HALAMAN PELATIH</span>
                </button>

                <p class="text-[10px] sm:text-[11px] text-center text-slate-400">
                    Masuk menggunakan User dan Password Pelatih yang terdaftar pada Admin.
                </p>
            </form>
        </div>
    </section>

    <!-- ==================== HALAMAN KHUSUS PELATIH DENGAN SIDEBAR ==================== -->
    <section id="page-pelatih" class="hidden flex-1 flex min-h-screen overflow-x-hidden relative">

        <!-- OVERLAY SIDEBAR (MOBILE) -->
        <div id="sidebar-overlay" onclick="setSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-[1px] z-40 hidden lg:hidden transition-opacity"></div>

        <!-- SIDEBAR NAVIGASI PELATIH -->
        <aside id="pelatih-sidebar"
            class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-2xl transition-all duration-300 ease-in-out -translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">

            <div class="flex flex-col flex-1 overflow-y-auto">
                <!-- Header Sidebar + Tombol Tutup -->
                <div class="px-4 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-black tracking-wider text-white uppercase truncate">Panel Pelatih</p>
                            <p class="text-[10px] text-slate-400 truncate">Gelanggang PD</p>
                        </div>
                    </div>
                    <button type="button" onclick="setSidebar(false)" title="Tutup Sidebar"
                        class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Profil Pelatih di Sidebar -->
                <div class="p-4 border-b border-slate-800/80 bg-slate-900/50">
                    <div class="flex items-center gap-3">
                        <div id="sidebar-avatar" class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black text-sm border-2 border-emerald-400 shrink-0 overflow-hidden">
                            P
                        </div>
                        <div class="min-w-0">
                            <p id="sidebar-nama-pelatih" class="text-xs font-bold text-white truncate">Pelatih</p>
                            <p id="sidebar-rayon-pelatih" class="text-[11px] text-emerald-400 font-medium truncate">
                                <i class="fa-solid fa-location-dot text-[9px] mr-1"></i>Ranting / Rayon
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Menu Sidebar Pelatih -->
                <nav class="p-3 space-y-1.5 flex-1">
                    <p class="px-3 pt-1 pb-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Menu Pelatih</p>

                    <button type="button" onclick="pilihTab('dashboard')" data-tab="dashboard"
                        class="sidebar-btn sidebar-link-active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-gauge-high w-4 text-center"></i>
                        <span>Dashboard Rayon</span>
                    </button>

                    <button type="button" onclick="pilihTab('peserta')" data-tab="peserta"
                        class="sidebar-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <span class="flex items-center gap-3 min-w-0">
                            <i class="fa-solid fa-users w-4 text-center text-emerald-400 shrink-0"></i>
                            <span class="truncate">Data Peserta Rayon</span>
                        </span>
                        <span id="sidebar-peserta-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-600/30 text-emerald-300 shrink-0">0</span>
                    </button>

                    <button type="button" onclick="pilihTab('absensi')" data-tab="absensi"
                        class="sidebar-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <span class="flex items-center gap-3 min-w-0">
                            <i class="fa-solid fa-clipboard-user w-4 text-center text-amber-400 shrink-0"></i>
                            <span class="truncate">Absensi Anggota</span>
                        </span>
                        <span id="sidebar-absensi-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500 text-slate-950 shrink-0">0</span>
                    </button>

                    <button type="button" onclick="pilihTab('kasAnggota')" data-tab="kasAnggota"
                        class="sidebar-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <span class="flex items-center gap-3 min-w-0">
                            <i class="fa-solid fa-wallet w-4 text-center text-sky-400 shrink-0"></i>
                            <span class="truncate">Riwayat Kas Anggota</span>
                        </span>
                        <span id="sidebar-kas-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500 text-slate-950 shrink-0">0</span>
                    </button>
                </nav>
            </div>

            <!-- Footer Sidebar -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 space-y-2">
                <button type="button" onclick="prosesLogout()"
                    class="w-full bg-rose-600/90 hover:bg-rose-600 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Keluar Pelatih</span>
                </button>
                <p class="text-[10px] text-center text-slate-500">Portal Khusus Pelatih</p>
            </div>
        </aside>

        <!-- AREA KONTEN UTAMA -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <header class="bg-emerald-700 text-white sticky top-0 z-30 shadow-md">
                <div class="px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <button type="button" onclick="toggleSidebar()" title="Buka / Tutup Sidebar"
                            class="w-10 h-10 rounded-xl bg-emerald-600 hover:bg-emerald-500 border border-emerald-500/40 flex items-center justify-center transition-colors shrink-0 cursor-pointer">
                            <i class="fa-solid fa-bars text-base"></i>
                        </button>
                        <div class="min-w-0">
                            <h1 id="topbar-title" class="text-sm sm:text-base font-bold truncate">Dashboard Pelatih</h1>
                            <p id="topbar-rayon" class="text-[11px] text-emerald-100 truncate">Gelanggang PD</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2.5 shrink-0">
                        <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-bold bg-emerald-800/70 px-3 py-1.5 rounded-xl border border-emerald-500/30">
                            <i class="fa-solid fa-database text-emerald-300"></i> Sync Realtime
                        </span>
                        <button type="button" onclick="prosesLogout()"
                            class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3 py-2 rounded-xl shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="hidden sm:inline">Keluar</span>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Toast Notifikasi -->
            <div id="toast-notif" class="fixed bottom-4 right-4 z-[70] hidden max-w-sm bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl border border-slate-700 flex items-center gap-2.5">
                <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
                <span id="toast-text">Berhasil disimpan.</span>
            </div>

            <!-- Konten Utama -->
            <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">

                <!-- ==================== 1. DASHBOARD PELATIH ==================== -->
                <section id="sec-dashboard" class="pelatih-section space-y-6">
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-gauge-high text-lg"></i>
                            </div>
                            <div>
                                <h2 id="dash-welcome-title" class="text-sm sm:text-base font-bold text-slate-800">Ringkasan Rayon / Ranting</h2>
                                <p id="dash-welcome-sub" class="text-[11px] text-slate-500">Data khusus anggota, absensi, dan kas anggota binaan Anda</p>
                            </div>
                        </div>
                        <button type="button" onclick="toggleKolomMenu('dashboard')" id="btn-plus-dashboard"
                            class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition-all cursor-pointer">
                            <i id="icon-plus-dashboard" class="fa-solid fa-plus"></i>
                            <span>Aksi Cepat Pelatih</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Kolom Menu Cepat Pelatih -->
                        <div id="kolom-menu-dashboard" class="hidden lg:col-span-1 bg-white rounded-2xl border border-emerald-200 shadow-sm overflow-hidden h-fit">
                            <div class="px-5 py-4 bg-emerald-50/80 border-b border-emerald-100 flex items-center justify-between">
                                <h3 class="text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                    <i class="fa-solid fa-bolt mr-1.5"></i>Aksi Cepat Pelatih
                                </h3>
                                <button type="button" onclick="toggleKolomMenu('dashboard', false)" class="text-slate-400 hover:text-slate-600 cursor-pointer">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <div class="p-4 space-y-3">
                                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Wilayah Binaan</p>
                                    <p id="dash-profil-rayon" class="font-bold text-emerald-700">-</p>
                                    <p id="dash-profil-pelatih" class="text-[11px] text-slate-600">-</p>
                                </div>
                                <div class="space-y-2 pt-1">
                                    <p class="text-[11px] font-bold text-slate-500 uppercase">Navigasi &amp; Input Cepat</p>
                                    <div class="grid grid-cols-1 gap-2">
                                        <button type="button" onclick="bukaFormMenu('absensi')" class="p-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold text-left transition-colors cursor-pointer">
                                            <i class="fa-solid fa-plus mr-1.5"></i>Catat Absensi Anggota
                                        </button>
                                        <button type="button" onclick="bukaFormMenu('kasAnggota')" class="p-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 text-xs font-bold text-left transition-colors cursor-pointer">
                                            <i class="fa-solid fa-plus mr-1.5"></i>Catat / Konfirmasi Kas Anggota
                                        </button>
                                        <button type="button" onclick="pilihTab('peserta')" class="p-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold text-left transition-colors cursor-pointer">
                                            <i class="fa-solid fa-users mr-1.5"></i>Lihat Data Peserta Rayon
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Konten Statistik Dashboard Pelatih -->
                        <div id="konten-dashboard" class="lg:col-span-3 space-y-6">
                            <!-- Kartu Utama -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                                <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Peserta Rayon</p>
                                    <p id="dash-total-peserta" class="text-2xl font-black text-slate-800 mt-1">0</p>
                                    <p id="dash-putra-putri" class="text-[11px] text-slate-500 mt-0.5">0 Putra • 0 Putri</p>
                                </div>
                                <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Absensi Hari Ini</p>
                                    <p id="dash-absen-hari-ini" class="text-2xl font-black text-amber-600 mt-1">0</p>
                                    <p id="dash-absen-hadir-total" class="text-[11px] text-slate-500 mt-0.5">0 Total Hadir tercatat</p>
                                </div>
                                <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Kas Terkonfirmasi</p>
                                    <p id="dash-kas-ok" class="text-lg sm:text-xl font-black text-emerald-600 mt-1 truncate">Rp 0</p>
                                    <p id="dash-kas-pending" class="text-[11px] text-slate-500 mt-0.5">0 Menunggu konfirmasi</p>
                                </div>
                                <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Total Transaksi Kas</p>
                                    <p id="dash-total-kas-count" class="text-2xl font-black text-sky-600 mt-1">0</p>
                                    <p id="dash-kas-ringkas" class="text-[11px] text-slate-500 mt-0.5">0 Dikonfirmasi • 0 Ditolak</p>
                                </div>
                            </div>

                            <!-- Jadwal Latihan Rayon & Distribusi Kualifikasi -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                                    <div class="px-5 py-3.5 border-b border-slate-100 bg-slate-50/70 flex items-center justify-between">
                                        <h3 class="text-xs sm:text-sm font-bold text-slate-800">Jadwal Latihan Rayon / Ranting Anda</h3>
                                        <span class="text-[11px] font-semibold text-purple-600">Realtime</span>
                                    </div>
                                    <div id="dash-jadwal-rayon" class="p-4 space-y-2.5 max-h-72 overflow-y-auto">
                                        <p class="text-xs text-slate-400 text-center py-6">Memuat jadwal latihan...</p>
                                    </div>
                                </div>

                                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                                    <div class="px-5 py-3.5 border-b border-slate-100 bg-slate-50/70 flex items-center justify-between">
                                        <h3 class="text-xs sm:text-sm font-bold text-slate-800">Distribusi Kualifikasi Usia Anggota</h3>
                                        <span id="dash-rayon-badge" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">-</span>
                                    </div>
