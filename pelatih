            return dataKasAnggotaRayon.filter(item => {
                const st = item.status || "Menunggu";
                const matchStatus = !filterStatus || st === filterStatus;
                const teks = `${item.nama_anggota || ""} ${item.ranting_rayon || ""} ${item.keterangan || ""} ${item.tanggal || ""}`.toLowerCase();
                return matchStatus && teks.includes(kueri);
